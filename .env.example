# ─── Database (required) ────────────────────────────────────────────────
# Neon Postgres connection string (pooled). Prisma reads this.
DATABASE_URL="postgresql://user:password@localhost:5432/aetherav"

# ─── App (required in production) ───────────────────────────────────────
# Public origin of the deployment — used in payment links, PDFs, e-sign URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Clerk auth (optional — demo mode without it) ───────────────────────
# Both keys present = real signup/sign-in + per-company workspaces.
# Absent = demo mode against the first seeded workspace.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ─── Anthropic AI (optional — AI features disabled without it) ──────────
# Powers the AI Builder (Opus) + Co-pilot/generation endpoints (Sonnet).
ANTHROPIC_API_KEY=""
# Override the default models if Anthropic rotates IDs:
# ANTHROPIC_MODEL="claude-opus-4-7"           # heavy Project Builder
# ANTHROPIC_COPILOT_MODEL="claude-sonnet-4-5" # co-pilot + generation

# Per-workspace monthly AI generation caps (optional overrides):
# AI_LIMIT_BASIC=150
# AI_LIMIT_PRO=2000
# AI_LIMIT_ENTERPRISE=50000

# ─── Razorpay payments & plan upgrades (optional) ───────────────────────
# Invoice payment links + plan upgrade checkout. Webhook flips Workspace.plan.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Must match the secret you set on the webhook at dashboard.razorpay.com
# (events: payment_link.paid, payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=""

# ─── Supabase Storage (optional — file uploads disabled without it) ─────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="zynexav-files"

# ─── Cron protection (recommended in production) ────────────────────────
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/automations.
# Without it, anyone can trigger the (idempotent) automations runner.
CRON_SECRET=""
